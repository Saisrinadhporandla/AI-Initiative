	End Try
end fillDetailsInNeedsResolution

(*
This Handlers helps to check The On HOld Reason is updatd with needs Resolution 
and navigating to Salesforce inspector to check its tata paused value
*)
to checkNeedsResolutionAndValidateInInspector
	try
		wait 2
		"POM/WOHandlers".checkAndStoreOnHoldReasonAndTime "Needs Resolution"
		"POM/WOHandlers".navigateSalesforceInspector
		KeyHandlers.textEntry "Filter","TAT Paused","headerSection"
		put KeyHandlers.readField("Value",[1,20],"HeaderSection") into TATPausedValue
		put KeyHandlers.readField("Value",[1,40],"HeaderSection") into TATPausedTime
		KeyHandlers.validateValues ["Value"]
		"POM/InitiateAndAuthenticate".readUserProfilesAndHoldReason "","Needs Resolution"
		KeyHandlers.validateField "Value",universal TATPauseData."tat pause value",[1,20],"headerSection"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end checkNeedsResolutionAndValidateInInspector

(*
This Handler helps to remove the Needs Resolution  
*)
to clearNeedsResolution
	try
		KeyHandlers.clickElement "Activity","leftPanel"
		set the TextStyle to {DPI:250}
		KeyHandlers.validateValues "Work Order - Needs Resolution","leftPanel"
		set the TextStyle to {DPI:250}
		KeyHandlers.clickInsideElement "Work Order - Needs Resolution","leftPanel",[-115,0]
		set the TextStyle to {DPI:72}
		wait 3
		CaptureScreen {Name:suiteInfo().resultsFolder&slash&snaps&slash&"ClearNeedsResolution" && the hour && the minute }
		"POM/InitiateAndAuthenticate".refreshBrowser
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end clearNeedsResolution

(*
This Handler helps to check the On Hold Time for the Needs Resolution
*)
to validateOnHoldTimeDifferenceForNeedsResolution
	try
		"POM/WOHandlers".navigateToScheduling
		KeyHandlers.scrollTo "On Hold Time","leftPanel",,2
		put KeyHandlers.readField("On Hold Time",[110,0],"leftPanel") into onHoldTime
		assert that universal onHoldTime is  onHoldTime with "Not change in time"
		log "On Hold Time difference : "&(onHoldTime-universal onHoldTime)
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end validateOnHoldTimeDifferenceForNeedsResolution

