(****
COMMONLY USED LINES IN FRAMEWORK :-
the TextStyle : This function is used to configure properties for Optical Character Recognition (OCR) when the default settings struggle to accurately identify text.
ErrorMessageCustomization.captureScreenAndNotifyError theException : This handler captures any exceptions that occur when the script fails, providing a user-friendly error message in the console and taking a snap of the failure.
Params : This refers to the parameters or arguments that are passed to a function or script to customize its behavior or input data. These parameters allow users to specify different values or configurations for the automation tasks, enabling more flexible and reusable scripts
****)

(*
This Handler helps to create the New WorkOrder
*)
to createWorkOrder
	try
		KeyHandlers.validateValues "Bulk Work Order Create","headerSection"
		KeyHandlers.clickElement "New","headerSection"
		KeyHandlers.validateValues "New Work Order","headerSection"
		wait 3
		KeyHandlers.clickElement "Search Assets","leftPanel"
		#Enter the Asset Name in the Asset Label
		KeyHandlers.enterText "EggplantRegressionTest"
		wait 2
		KeyHandlers.clickElement "EggplantRegressionTestAsset","leftPanel"
		#selecting the Value from the dropDown
		KeyHandlers.dropDown "Business Unit","MSD",KeyHandlers.generateSRForLabel("Business Unit","topHalf","leftPanel"),(Sections().offset().nullOffset)
		KeyHandlers.clickElement "Business Unit","leftPanel"
		KeyHandlers.dropDown "Sales Group","MSD",KeyHandlers.generateSRForLabel("Sales Group","topHalf","leftPanel"),(Sections().offset().nullOffset)
		KeyHandlers.dropDown "Bill To Contact","Gopi Krishna",KeyHandlers.generateSRForLabel("Bill To Contact","topHalf","leftPanel"),[0,15]
		KeyHandlers.dropDown "Ship To Contact","Gopi Krishna",KeyHandlers.generateSRForLabel("Ship To Contact","topHalf","leftPanel"),[0,15]
		KeyHandlers.scrollTo "Expected Pick Up Date","leftHalf",,2
		set the TextStyle to {DPI:144}
		(*		KeyHandlers.textEntry  "Service Bundle","Repair On","leftPanel",[150,0]
		KeyHandlers.mouseActionOnPreferredElement "Repair Only","leftPanel",2*)
		KeyHandlers.validateValues "Repair Only",KeyHandlers.generateSRForLabel("Service Bundle","topHalf","leftPanel")
		KeyHandlers.scrollTo "Choose Entitlement","leftHalf",,2
		KeyHandlers.dropDown "Expected Pick Up","Today",KeyHandlers.generateSRForLabel("Expected Pick Up","topHalf","leftPanel"),(Sections().offset().nullOffset)
		wait 2
		KeyHandlers.clickElement "Expected Receipt","leftPanel"
		KeyHandlers.clickElement "Receiving Method","leftPanel"
		KeyHandlers.clickElement "Keysight Arrange Pickup","leftPanel"
		KeyHandlers.scrollTo "Trade","bottomHalf"
		KeyHandlers.validateValues "Warranty Entitlements","leftHalf"
		KeyHandlers.radioSelect "workOrder/icons/radioButton",KeyHandlers.generateSRForLabel("Trade",[-500,-20,1000,20],"leftPanel")
		KeyHandlers.scrollTo "Save","bottomHalf"
		#Validating the Asset Serive Note in the Accepted State or not
		KeyHandlers.validateValues "Accepted",KeyHandlers.generateSRForLabel("Asset Service Note","topHalf","leftPanel")
		KeyHandlers.clickElement "Save","bottomHalf"
		log "Work Order Created"
		wait 20
		try
			KeyHandlers.validateValues "Work Order Number","leftPanel",15
		catch
			KeyHandlers.clickElement "Work Order",KeyHandlers.generateSRForLabel("Work Order",[-10,20,500,500],"bottomHalf")
			KeyHandlers.validateValues "Work Order Number","leftPanel"
		end try
		#Reading the Work Order Number and URL into Excel
		"POM/InitiateAndAuthenticate".readTestData
		put KeyHandlers.readField("Work Order Number",[150,10],"leftPanel") into universal WOData.workOrder
		log "Work Order Created : "&universal WOData.workOrder
		put "POM/InitiateAndAuthenticate".getURL  into universal WOData.workOrderURL
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end createWorkOrder

(*
This Handler helps to navigate to the Work Order from module DropDown
*)
to navigateToWorkOrders
	try
		"POM/LandingPage".navigateToSDCModule "Work Orders"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end navigateToWorkOrders

(*
This handler helps to check whether the On HOld Reason in Wait For Customer PO  or not
*)
to checkWaitForCustomerPO
	try
		KeyHandlers.validateValues "Complete",(KeyHandlers.generateSRForLabel("Work Order Service","topHalf","rightPanel"))
		removeGTMHold
		"POM/WOHandlers".checkAndStoreOnHoldReasonAndTime "customer PO"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end checkWaitForCustomerPO

(*
this handler helps to add data into ACCAuth label
*)
to setAcctAuthToClearHoldReason
	try
		"POM/WOHandlers".	collapseAllLightningArrows
		KeyHandlers.scrollTo "Financial Details","leftPanel",,3
		try
			KeyHandlers.validateValues "Acct Auth","leftPanel",5
		catch
			#Click on the Financial Details Tab
			KeyHandlers.clickElement "Financial Details","leftPanel"
		end try
		KeyHandlers.scrollTo "Acct Auth","leftPanel",,3
		KeyHandlers.mouseActionOnPreferredElement "Acct Auth","leftPanel",,DoubleClick
		wait 2 ticks
		KeyHandlers.enterText "Test234567"
		wait 2
		KeyHandlers.clickElement "Save","bottomHalf"
		wait 5
		"POM/InitiateAndAuthenticate".refreshBrowser
		try
			KeyHandlers.validateValues "Work Order Number","leftPanel",5
		catch
			KeyHandlers.clickElement "Work Order",KeyHandlers.generateSRForLabel("Work Order",[-10,20,500,500],"bottomHalf")
		end try
		KeyHandlers.validateValues "On Hold Reason","leftpanel"
		#validating the On HOld Reason is empty or not
		KeyHandlers.validateField "On Hold Reason","",[150,0],"leftPanel"
		"POM/WOHandlers".navigateSalesforceInspector
		KeyHandlers.textEntry "Filter","TAT Paused","headerSection"
		#checking the tat paused value 
		KeyHandlers.validateValues "False"
		KeyHandlers.validateField "Value","False",[1,20],"headerSection"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end setAcctAuthToClearHoldReason

(*
This Handler helps to validate the tat paused value for the Wait For customer PO
*)
to validateTATPausedValueForWaitforCustomerPO
	try
		"POM/WOHandlers".navigateSalesforceInspector
		KeyHandlers.textEntry "Filter","TAT Paused","headerSection"
		put KeyHandlers.readField("Value",[1,20],"HeaderSection") into TATPausedValue
		put KeyHandlers.readField("Value",[1,40],"HeaderSection") into TATPausedTime
		KeyHandlers.validateValues ["Value"]
		"POM/InitiateAndAuthenticate".readUserProfilesAndHoldReason "","Wait for customer PO"
		KeyHandlers.validateField "Value",universal TATPauseData."tat pause value",[1,20],"headerSection"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end validateTATPausedValueForWaitforCustomerPO

(*
This Handler helps to validate the Onhold Time for the wait for Customer PO On hold Reason
*)
to validateOnHoldTimeDifferenceForWaitCustomerPO
	try
		"POM/WOHandlers".navigateToScheduling
		wait 1
		KeyHandlers.scrollTo "On Hold Time","leftPanel",,2
		put KeyHandlers.readField("On Hold Time",[110,0],"leftPanel") into onHoldTime
		#Checking that their is a change in the OnHold Time or not
		assert that universal onHoldTime is not equal to onHoldTime with "Difference in time : "&(onHoldTime-universal onHoldTime)
		log "On Hold Time difference : "&(onHoldTime-universal onHoldTime)
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end validateOnHoldTimeDifferenceForWaitCustomerPO

