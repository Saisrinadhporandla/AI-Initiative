(*
This Handler helps to open the Work Order
Prams workOrder:Passing the Work Order Number from Excel
Params workOrderURL:Passing the Work order URL link from Excel
*)
to openWorkorder
	params workOrderURL :universal WOData.workOrderURL, workOrder: universal WOData.workOrder
	try
		TypeText controlKey,l
		TypeText workOrderURL,returnKey
		KeyHandlers.webPageLoad
		KeyHandlers.validateValues workOrder,"leftHalf"
		#close all the Lighting Arrows
		"POM/WOHandlers".collapseAllLightningArrows
		wait 3
		KeyHandlers.clickElement "Work Order",KeyHandlers.generateSRForLabel("Activity",[-200,20,500,500],"bottomHalf")
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end openWorkorder

(*
This Handler helps to fill the Necessary fields After Clicking On the Receiving Button in the Work order Page
*)
to performReceiving
	try
		KeyHandlers.validateValues "Receiving","topHalf"
		KeyHandlers.clickElement "Receiving","topHalf"
		#After Clicking the Receiving Pop-up will Appear
		set the TextStyle to {contrast:"On", contrastColor:"#2E91DC", contrastTolerance:"49"}
		KeyHandlers.validateValues "Receive","bottomHalf"
		set the TextStyle = ""
		KeyHandlers.clickElement "Asset Options","verticalMiddle"
		KeyHandlers.textEntry "Country","NA","verticalMiddle"
		KeyHandlers.scrollTo "Accessories","verticalMiddle",,2
		KeyHandlers.mouseActionOnPreferredElement "Accessories","verticalMiddle",2
		KeyHandlers.enterText "test"
		KeyHandlers.scrollTo "Receiving Safety Test Result","verticalMiddle",,2
		KeyHandlers.dropDown "None","Passed",KeyHandlers.generateSRForLabel("Receiving Safety Test Result","topHalf","leftPanel"),(Sections().offset().nullOffset)
		KeyHandlers.scrollTo "Visual Inspection","verticalMiddle"
		KeyHandlers.dropDown "None","Passed",KeyHandlers.generateSRForLabel("Visual Inspection","topHalf","leftPanel"),(Sections().offset().nullOffset)
		wait 2
		KeyHandlers.textEntry "None","FedEX"
		wait 1
		KeyHandlers.textEntry "Tracking Number","TECRF345","verticalMiddle"
		KeyHandlers.clickElement "Receive","footerSection"
		try 
			KeyHandlers.validateValues "Success","headerSection"
		end try
		openWorkorder
		KeyHandlers.validateField "Status","In Progress",[100,0],"bottomHalf"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try		
end performReceiving

(*
This Handler helps to Add Work Order Service
*)
to manageServices
	try	
		KeyHandlers.validateValues "Work Order Service","rightPanel"
		#Click on the Manage Services
		KeyHandlers.clickElement "Manage Services","rightPanel"
		KeyHandlers.validateValues "SERVICE TYPE","leftHalf"
		KeyHandlers.clickElement "Calibration/Test/Verification","leftHalf"
		KeyHandlers.clickInsideElement  "Calibration",KeyHandlers.generateSRForLabel("Accredited Calibration",[-70,20,500,500]),[-110,0]
		try
			KeyHandlers.validateValues "Added to Deliverable Service","headerSection",1
		End try	
		KeyHandlers.clickInsideElement "Calibration UMU","Center",[-110,0]
		try
			KeyHandlers.validateValues "Added to Deliverable Service","headerSection",1
		End try	
		KeyHandlers.clickElement "Repair","topHalf"
		KeyHandlers.clickInsideElement "Technical Evaluation","Center",[-120,0]
		try
			KeyHandlers.validateValues "Added to Deliverable Service","headerSection",1
		End try	
		KeyHandlers.scrollTo "Save","footerSection"
		#validating the Added Work Order Services
		set the SearchRectangle to KeyHandlers.generateSRForLabel("Work Order Service Name","topHalf","bottomHalf")
		KeyHandlers.validateValues ["Logistics (Inbound)","TestSNote","Repair","Calibration"], the SearchRectangle
		KeyHandlers.clickElement "Repair", the SearchRectangle
		KeyHandlers.scrollTo "Technical Evaluation", the SearchRectangle
		KeyHandlers.validateValues ["Calibration UMU"], the SearchRectangle
		log "successfully added calibration,calibration UMU and technical Evaluation"
		KeyHandlers.clickElement "Save","footerSection"
		try 
			KeyHandlers.validateValues "manual","headerSection"
		end try
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end manageServices

(*
This Handler helps to remove the Technical Evalution WOS
*)
to removeTechnicalEvaluation
	try
		KeyHandlers.validateValues "Work Order Service","rightPanel"
		KeyHandlers.clickElement "workOrder/icons/moduleDropdown",KeyHandlers.generateSRForLabel("Technical","topHalf","rightPanel")
		KeyHandlers.mouseActionOnPreferredElement "Delete","rightPanel"
		KeyHandlers.validateValues "Delete Work Order Service","Center"
		KeyHandlers.clickElement "Delete",(KeyHandlers.generateSRForLabel("Cancel","leftHalf","bottomHalf"))
		try
			set the TextStyle to {DPI:144}
			KeyHandlers.validateValues "deleted","headerSection",10
		end try
		log "Deleted Technical Evaluation"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end removeTechnicalEvaluation

(*
This Handler Helps to navigate to Particular Work Order Services
Params:Pass the Required WOs
*)
to navigateToParticularWorkOrderService
	Params WOSName:"Repair"
	try
		set the SearchRectangle to KeyHandlers.generateSRForLabel("Work Order Service Name","topHalf","rightPanel")
		KeyHandlers.clickElement WOSName, the SearchRectangle
		KeyHandlers.validateValues "Ship To Address","leftPanel"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end navigateToParticularWorkOrderService

(*
This Hnalder helps to identify Errors After Clicking On the Complete in the WOS
*)
to validateErrorDiagnoisesQuoteDetailsQuoteAcceptance
	try
		KeyHandlers.clickElement "Complete","rightHalf"
		KeyHandlers.clickElement "Mark as Current Status","rightHalf"
		set the TextStyle to {DPI:144}
		KeyHandlers.validateValues "You encountered some errors when trying to save this record","headerSection"
		--KeyHandlers.validateValues "You encountered some errors when trying to save this record Quote Details: Please provide Quote Details. Diagnosis: Diagnosis can not be empty. Quoted Acceptance: Please select Quoted Acceptance. Action Taken: Please make sure you have provided value for"&&quote&"Action Taken"&quote&&"Service Report: Please make sure you have provided value for"&&quote& "Service Report"&quote&&"Status: The Work Order is currently On Hold, therefore you can not progress this Service until this has been resolved","headerSection"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end validateErrorDiagnoisesQuoteDetailsQuoteAcceptance

(*
This Handler helps to fill Work Order Labour(WOL) hours and Work order Quoted Labour(WOQL) hours
*)
to fillHoursForWOLAndWOQL
	try
		KeyHandlers.validateValues "To Do","leftPanel"
		wait 3
		set the TextStyle to {DPI:144}
		set the SearchRectangle to KeyHandlers.generateSRForLabel("Work Order Labours","topHalf","rightPanel")
		KeyHandlers.mouseActionOnPreferredElement "Repair",the SearchRectangle,,DoubleClick
		wait 2
		KeyHandlers.textEntry "Repair",6,the SearchRectangle,[250,0]
		KeyHandlers.clickElement "Save",the SearchRectangle
		wait 2
		set the TextStyle to {DPI:144}
		set the SearchRectangle to KeyHandlers.generateSRForLabel("Work Order Quoted Labours","topHalf","rightPanel")
		KeyHandlers.mouseActionOnPreferredElement "Repair",the SearchRectangle,,DoubleClick
		wait 1
		KeyHandlers.textEntry "Repair",16,the SearchRectangle,[300,0]
		KeyHandlers.clickElement "Save",the SearchRectangle
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end fillHoursForWOLAndWOQL

to performAndCompleteServiceNoteService
	removeGTMHold
	KeyHandlers.scrollTo "Ship To Service Account","leftHalf",UP
	fillTestSNoteWOS "TestSNote"
	fillWOLHours
	WOSChangedTOComplete
end performAndCompleteServiceNoteService

(*
This Handler helps to fill the Diagnosis Data in the TestSNote WOS
*)
to fillTestSNoteWOS
	Params WOS:"Repair"
	try
		navigateToParticularWorkOrderService WOS
		#Double Click on the Diagnosi To enble the field and enter required Data
		KeyHandlers.mouseActionOnPreferredElement "Diagnosis","leftPanel",,DoubleClick 
		KeyHandlers.clickElement "Diagnosis","leftPanel"
		KeyHandlers.enterText "test"
		KeyHandlers.scrollTo "Quote Details","leftPanel",,2
		KeyHandlers.clickElement "Quote Details","leftPanel"
		KeyHandlers.enterText "test"
		KeyHandlers.scrollTo "Service Report","leftPanel",,2
		KeyHandlers.clickElement "Service Report","leftPanel"
		KeyHandlers.enterText "test"
		KeyHandlers.scrollTo "Notes To Division","leftPanel",,2
		KeyHandlers.clickElement "Action Taken","leftPanel"
		KeyHandlers.enterText "test"
		try
			KeyHandlers.validateValues "Cause Code","leftPanel",5
			KeyHandlers.clickElement "Cause Code","leftPanel"
			KeyHandlers.clickElement "Workmanship","leftPanel"
		end try
		KeyHandlers.scrollTo "Quoted Acceptance","leftPanel",,2
		wait 1
		KeyHandlers.validateField  "Quoted Acceptance","Accept",[150,0],"leftPanel"
		set the TextStyle to {DPI:144}
		KeyHandlers.clickElement "Save",KeyHandlers.generateSRForLabel("Cancel","topHalf","leftHalf")
		KFeyHandlers.scrollTo "Ship To Address","topHalf","up"
		wait 2
		#Copying the WOS URL 
		TypeText controlKey,l
		TypeText controlKey,c
		#Clicking on the in Progress to change its state
		KeyHandlers.clickElement "In Progress","horizontalMiddle"
		KeyHandlers.clickElement "Mark as Current Status","rightPanel"
		try
			set the TextStyle to {DPI:144}
			KeyHandlers.validateValues "Status changed successfully","headerSection",2
			KeyHandlers.validateValues "You encountered some errors","headerSection",2
		end try	
		KeyHandlers.validateValues "Status changed successfully","headerSection",5
		
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end fillTestSNoteWOS

(*
This Handler helps to fill the WOL hours
*)
to fillWOLHours 
	try
		KeyHandlers.validateValues "Work Order Labours",KeyHandlers.generateSRForLabel("Work Order Parts","topHalf","rightPanel")
		KeyHandlers.clickElement "New",KeyHandlers.generateSRForLabel("Work Order Parts","topHalf","rightPanel")
		KeyHandlers.validateValues "New Work order Labour","verticalMiddle"
		KeyHandlers.clickElement "Date","verticalMiddle"
		KeyHandlers.clickElement "Today","verticalMiddle"
		wait 2
		KeyHandlers.clickElement "Hours","verticalMiddle"
		KeyHandlers.clickElement "Hours","verticalMiddle"
		KeyHandlers.enterText "4"
		KeyHandlers.clickElement "Labour Type","leftHalf"
		KeyHandlers.clickElement "Standard Time","leftHalf"
		KeyHandlers.clickElement "Activity","leftHalf"
		KeyHandlers.clickElement "Calibration","leftHalf"
		KeyHandlers.clickElement "Save","rightHalf"
		try
			KeyHandlers.validateValues "Work Order Labour","headerSection"
		end try
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end fillWOLHours

(*
This Handler help to Complete The TestSNote WOS
*)
to WOSChangedTOComplete
	try
		TypeText controlKey,"l"
		TypeText RemoteClipboard(),returnKey
		KeyHandlers.validateValues "Complete","rightPanel"
		KeyHandlers.clickElement "Complete","rightPanel"
		KeyHandlers.clickElement "Mark as Current Status","rightPanel"
		try 
			KeyHandlers.validateValues "Status Changed Successfully","headersection"
		end try	
		KeyHandlers.webPageLoad 
		put KeyHandlers.readField ("Status",[150,0],"leftPanel") into status
		log "Status changed to "&&status 
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end WOSChangedTOComplete

(*
This Handler helps to Remove the GTM Hold From On Hold Reason
*)
to removeGTMHold
	try
		KeyHandlers.scrollTo "On Hold Type","leftPanel",,2
		try
			KeyHandlers.validateValues "GTM Hold","leftPanel"
			KeyHandlers.mouseActionOnPreferredElement "On Hold Reason","leftPanel",,DoubleClick
			wait 4
			KeyHandlers.scrollTo "GTM Hold","leftPanel",,2
			KeyHandlers.clickElement "GTM Hold","leftPanel"
			KeyHandlers.clickElement "workOrder/icons/leftArrow","leftPanel"
			KeyHandlers.clickElement "Save",KeyHandlers.generateSRForLabel( "Cancel","topHalf","leftHalf")
		end try
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end removeGTMHold

(*
This Handler helps to remove Capability Verification from On Hold Reasons
*)
to capabilityVerification
	KeyHandlers.validateValues "Work Order Number","leftPanel"
	put  KeyHandlers.readField( "On Hold Reason",[170,0],"leftPanel") into onHoldReason
	log  onHoldReason
	"POM/LandingPage".navigateToSDCModule "Capability Verification"
	--KeyHandlers.validateValues "Work Order Services","leftHalf"
	KeyHandlers.clickElement "workOrder/icons/filterIcon","rightHalf"
	KeyHandlers.clickElement "Search","rightPanel"
	KeyHandlers.enterText "J902"
	KeyHandlers.clickElement "J902-Bangalore,India Hub","rightPanel"	
	KeyHandlers.clickElement "Apply","rightHalf"
	TypeText homeKey
	KeyHandlers.mouseActionOnPreferredElement "Work Order","leftHalf",,DoubleClick 
	--change should be done here like read the particular wok order
	KeyHandlers.validateField "Work Done By","J902 - Bangalore, India Hub",[0,30],"rightPanel"
	set the TextStyle to {DPI:144}
	KeyHandlers.clickElement "Calibration","leftPanel"
	KeyHandlers.scrollTo universal WOData.WorkOrder,"leftPanel"
	KeyHandlers.clickElement "workOrder/icons/moduleDropdown",KeyHandlers.generateSRForLabel (universal WOData.WorkOrder,"topHalf","bottomHalf")
	KeyHandlers.clickElement "Add","rightPanel"
	#adding Calibration to the Work order
	KeyHandlers.validateValues "Service Site","horizontalMiddle"
	KeyHandlers.clickElement "workOrder/icons/cancelIcon","horizontalMiddle"
	KeyHandlers.enterText "J901"
	KeyHandlers.clickElement "J901 - Hyderabad,India Hub","horizontalMiddle"
	KeyHandlers.validateValues "Work Center","horizontalMiddle"
	KeyHandlers.clickElement "Search","horizontalMiddle"
	KeyHandlers.enterText "DEFA"
	KeyHandlers.clickElement "DEFAULT","horizontalMidddle"
	KeyHandlers.clickElement "Turn Around Time","horizontalMiddle"
	KeyHandlers.enterText "6"
	KeyHandlers.clickElement "Save","rightPanel"
	try
		KeyHandlers.validateValues "Capability Created","headerSection"
	end try
	openWorkorder
	#Checking the Calibration Verification On Hold Reason is removed or not
	put  KeyHandlers.readField( "On Hold Reason",[170,0],"leftPanel") into onHoldReason
	log  onHoldReason&&"Capibilty verification was removed"
	KeyHandlers.validateValues "Work Order Service Name","rightPanel"
	KeyHandlers.clickElement "View All",KeyHandlers.generateSRForLabel ("Work Order Service Name","topHalf","rightPanel")
	KeyHandlers.clickElement "Calibration UMU","leftPanel"
	KeyHandlers.validateValues "Ship To Address","leftPanel"
	KeyHandlers.scrollTo "Work Done By","leftPanel","down",5
	wait 2
	put KeyHandlers.readField("Work Done By",[170,30],KeyHandlers.generateSRForLabel("Work Done By","topHalf","leftHalf")) into workDoneBy
	log "Work Done By changed"&&workDoneBy 
	openWorkorder
	put  KeyHandlers.readField( "On Hold Reason",[170,0],"leftPanel") into onHoldReason
	log  onHoldReason&&"Capibilty verification was removed"
end capabilityVerification

(*
This Handler helps to remove the Entitlement Check On Hold Reason
*)
to removeEntitlements
	try
	(*openWorkorder
		put KeyHandlers.readField("On Hold Reason",[140,0],"leftPanel") into onHoldReason
		log onHoldReason*)
		KeyHandlers.clickInsideElement "Receiving","rightHalf",[60,0]
		#click on the update Etitlements from action dropDown 
		KeyHandlers.clickElement "Update Entitlement","rightPanel"
		KeyHandlers.validateValues "Warranty Entitlements","horizontalMiddle"
		KeyHandlers.radioSelect "workOrder/icons/radioButton",KeyHandlers.generateSRForLabel("Trade",[-500,-20,1000,20],"horizontalMiddle")
		KeyHandlers.radioSelect "workOrder/icons/radioButton",KeyHandlers.generateSRForLabel("Trade",[-250,-20,1000,20],"horizontalMiddle")
		KeyHandlers.clickElement "Save","rightPanel"
		put KeyHandlers.readField("On Hold Reason",[140,0],"leftPanel") into onHoldReasonAfterRemovingEntitlement
		log onHoldReasonAfterRemovingEntitlement&&"Entitlements Check is removed"
		KeyHandlers.clickElement "Activity","leftPanel"
		set TextStyle to {DPI:250}
		#removing the Entitlement Check
		KeyHandlers.validateValues "Work Order - Entitlement Check" ,KeyHandlers.generateSRForLabel ("Upcoming & Overdue","topHalf","leftPanel")
		KeyHandlers.clickInsideElement "Work Order - Entitlement Check",KeyHandlers.generateSRForLabel ("Upcoming & Overdue","topHalf","leftPanel"),[-110,0]
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try		
	
end removeEntitlements 

(*
performPricingForRepairService
*)
to performPricingForRepairService
	addChargeCode
	applyPrice
	applyDiscount
	approvePrice
	sendEmailToCustomer
	quoteWorkOrder
end performPricingForRepairService

(*
This Handler helps to add Charge code to the WOS
*)
to addChargeCode
	try
		#helps to navigate to Pricing tab
		KeyHandlers.clickElement "Pricing","leftPanel"
		KeyHandlers.validateValues "Total List Amount","leftPanel"
		KeyHandlers.scrollTo "Work Order Invoices","leftPanel",,2
		wait 2
		KeyHandlers.clickElement "View All",KeyHandlers.generateSRForLabel("Split" ,"leftHalf","leftHalf")
		KeyHandlers.validateValues "Work Order Pricing","leftPanel"
		set the SearchRectangle to KeyHandlers.generateSRForLabel("WOS" ,"topHalf",KeyHandlers.generateSRForLabel("(Re" ,"topHalf","bottomHalf"))
		KeyHandlers.clickElement   "workOrder/icons/editIcon", the SearchRectangle
		wait 2
		KeyHandlers.clickElement "Search SPN/CHAR", the SearchRectangle
		#adding charge code to the repair WOS
		KeyHandlers.enterText "REL5A"
		KeyHandlers.clickElement "REL5A",KeyHandlers.generateSRForLabel("Show more" ,"topHalf","bottomHalf")
		KeyHandlers.scrollTo "Save","bottomHalf"
		KeyHandlers.clickElement "Save","bottomHalf"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end addChargeCode

(*
This Handler helps to add Price to the Work order
*)
to applyPrice
	try
		openWorkorder
		#navigating to the Pricing Tab
		KeyHandlers.clickElement "Pricing","leftPanel"
		KeyHandlers.validateValues "Total List Amount","leftPanel"
		KeyHandlers.scrollTo "SD BP Reporting","leftPanel",,2
		wait 3
		KeyHandlers.clickElement "New Quote","leftPanel"
		KeyHandlers.validateValues "Success","headerSection"
		#Navigating to the Quote page to apply price
		KeyHandlers.clickInsideElement "Quote","headerSection",[50,0]
		KeyHandlers.validateValues "Quote Information","leftPanel"
		put  "POM/InitiateAndAuthenticate".getUrl into universal WOQuoteURL
		KeyHandlers.clickElement "price","rightPanel"
		try 
			KeyHandlers.validateValues "success","headerSection"
		end try	
		wait 2
		KeyHandlers.scrollTo "Search this table","leftHalf",,10
		put "POM/InitiateAndAuthenticate".getNumberWithoutComma(KeyHandlers.readField("Net Price",[0,30],"bottomHalf")) into global netPrice
		log "Net Price is "&global netPrice
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end applyPrice

(*
This Handler helps to add Discount to the Quoted Work Order 
*)
to applyDiscount
	try
		KeyHandlers.scrollTo "Quote Information","leftHalf",Up,10
		KeyHandlers.clickElement "Apply Discount","leftPanel"
		#Filling the necessary details toapply the Discount
		KeyHandlers.validateValues "Select Discount","leftPanel"
		wait 2
		KeyHandlers.mouseActionOnPreferredElement "Select Discount 1",,,DoubleClick 
		KeyHandlers.clickElement "Select Discount 1","leftPanel"
		KeyHandlers.mouseActionOnPreferredElement "Discount 1",KeyHandlers.generateSRForLabel("Select Discount 1" ,"topHalf","leftPanel"),2
		wait 2
		KeyHandlers.clickElement "Negotiated discount","leftHalf"
		KeyHandlers.mouseActionOnPreferredElement "Discount 1 %",,1	
		KeyHandlers.enterText "12"
		KeyHandlers.clickElement "Save","rightPanel"
		KeyHandlers.scrollTo "Quote Information","leftHalf",Up,10
		KeyHandlers.validateValues "Apply Discount","rightHalf"
		#Clicking on the Apply Discount to apply the Discount
		KeyHandlers.clickElement "Apply Discount","rightHalf"
		try
			KeyHandlers.validateValues "Success","headerSection"
		end  try	
		wait 3
		typetext endKey
		KeyHandlers.scrollTo "Charge Code","horizontalMiddle",Down,10
		#Validating Discount APplied or not And checking the Price After Discount
		put KeyHandlers.readField ("Discount 1 Value",[0,30],"bottomHalf") into discount
		log "Discount"&&discount
		put "POM/InitiateAndAuthenticate".getNumberWithoutComma(KeyHandlers.readField("Net Price",[0,30],"bottomHalf")) into netPriceAfterDiscount
		log "Net Price After Discount"&&netPriceAfterDiscount
		assert that (global netPrice) minus (global netPrice*12%) is (netPriceAfterDiscount) with"  difference in net price after discount" 
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end applyDiscount	

(*
This Handler helps to Approve the Price
*)
to approvePrice
	try
		KeyHandlers.scrollTo "Quote Information","leftHalf",Up,10
		KeyHandlers.clickElement "Submit for Approval","topHalf"
		try
			KeyHandlers.validateValues "Success","headerSection"
		end try	
		KeyHandlers.clickElement "Approvals","leftHalf"
		KeyHandlers.clickElement "Approve","rightPanel"
		KeyHandlers.validateValues "Approve Work Order Quote","Center"
		KeyHandlers.enterText "test"
		KeyHandlers.clickElement "Approve","rightPanel"
		try
			KeyHandlers.validateValues "Work Order Quoted","headerSection"
		end try
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end approvePrice
(*
This Handler helps to send Email to the Customer
*)
to sendEmailToCustomer
	try
		KeyHandlers.scrollTo "Email Quote","topHalf",Up
		KeyHandlers.clickElement "Email Quote","topHalf"
		KeyHandlers.validateValues "CFD Parameter Entry","Center"
		KeyHandlers.validateValues "Sender Email","horizontalMiddle"
		KeyHandlers.validateValues "Recipient Email","horizontalMiddle"
		KeyHandlers.clickElement "Send Email","rightPanel"
		try
			KeyHandlers.validateValues "sent to your email address","headerSection"
		end try	
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end sendEmailToCustomer 

(*
This Handler helps to Quote the Work Order
*)
to quoteWorkOrder
	try
		openWorkorder
		KeyHandlers.scrollTo "Quoting","leftPanel",,2
		try
			KeyHandlers.validateValues "Quote Status","leftPanel",5
		catch
			KeyHandlers.clickElement "Quoting","leftPanel"
		end try
		wait 2
		put KeyHandlers.readField("Quote Status" ,[150,0],"leftPanel") into QuoteStatus
		log "Quote Status after sending Email"&&QuoteStatus
		typetext controlKey,l
		typetext universal WOQuoteURL,return
		KeyHandlers.webPageLoad
		KeyHandlers.validateValues "Quote Information"
		KeyHandlers.clickElement "Quote Accepted","rightHalf"
		try
			KeyHandlers.validateValues "Success","headerSection"
		end try
		KeyHandlers.clickElement "Quote information","lefPanel"
		put KeyHandlers.readField("Quote Status" ,[170,0],KeyHandlers.generateSRForLabel("Quote Details","topHalf","leftPanel")) into QuoteStatus
		log "Quote Status after Accepting Quote"&&QuoteStatus
		#Navigating to the Work Order and checking the Quote Status
		openWorkorder
		KeyHandlers.scrollTo "Quoting","leftPanel",,2
		try
			KeyHandlers.validateValues "Quote Status","leftPanel",5
		catch
			KeyHandlers.clickElement "Quoting","leftPanel"
		end try
		put KeyHandlers.readField("Quote Status" ,[150,0],"leftPanel") into QuoteStatus
		log "Quote Status in WO : "&&QuoteStatus
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end quoteWorkOrder

(*
This Handler helps to change the Status of the Work Order
*)
to changeStatusToQuotedtoActual
	try
		navigateToParticularWorkOrderService "Repair"
		KeyHandlers.clickElement "Ship To Address","leftHalf"
		KeyHandlers.scrollTo "Quoted Price","leftPanel",,2
		wait 3
		#Validating Quoted Price and Actual Price
		KeyHandlers.validateField "Quoted Price",,[150,0],"leftPanel"
		KeyHandlers.validateField "Actual Price",,[150,0],"leftPanel"
		KeyHandlers.scrollTo "Ship To Address","topHalf",UP,7
		#Changing the status of the Work order to Quoted VS Actual
		KeyHandlers.clickElement "Quoted VS Actual","rightPanel"
		KeyHandlers.clickElement "Mark as Current Status","rightPanel"
		try
			set the TextStyle to {DPI:144}
			KeyHandlers.validateValues "Status changed successfully","headerSection",5
		end try
		wait 2
		Run "POM/InitiateAndAuthenticate".refreshBrowser
		KeyHandlers.clickElement "Ship To Address","leftHalf"
		KeyHandlers.scrollTo "Quoted Price","leftPanel",,2
		wait 3
		#Validating the Quoted And Actual Price after chnaging the Work Order Status
		put KeyHandlers.readField( "Quoted Price",[150,0],"leftPanel") into QuotedPrice
		log "Quote Price Added Successfully"&&QuotedPrice
		put KeyHandlers.readField( "Actual Price",[150,0],"leftPanel") into ActualPrice 
		log "Actual Price Added Successfully"&&ActualPrice
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end changeStatusToQuotedtoActual 
(*
This Handler helps to delete the Work Order Labour(WOL)
