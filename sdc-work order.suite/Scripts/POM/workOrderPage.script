(*
This handler helps to create new Work order Quoted labour(WOQL) 
*)
to createNewWOQL
	try
		KeyHandlers.validateValues "Work Order Labour","rightPanel"
		KeyHandlers.clickElement "New",KeyHandlers.generateSRForLabel("Work Order Quoted Labours","topHalf","rightPanel")
		#After clicking new pop up displays
