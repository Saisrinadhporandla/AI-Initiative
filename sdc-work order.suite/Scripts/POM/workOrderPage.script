(* 
This handler will navigate to the Order Parts and Creates an Order Part
*)
to fillInFormOrderParts
	try
		#Clicks the Order Parts 
		KeyHandlers.clickElement "Order Parts",KeyHandlers.generateSRForLabel("Work Order Parts",[100,-10,750,100])
		wait 1
		#Searches the Product 
		KeyHandlers.textEntry "Product Search","1250-125","leftHalf",[50,20]
		wait 1
		typetext return
		set the TextStyle to {DPI:250}
		KeyHandlers.clickElement "1250-1250","leftHalf"
		set the TextStyle to {DPI:72}
		KeyHandlers.dropDown "Select ShipperNotes","Exchange Only - No Item Substitution","topHalf",[50,20]
		#Submits the selected Product 
		KeyHandlers.clickElement "Submit","topHalf"
		KeyHandlers.clickElement "Yes","center"
		"POM/WOHandlers".validateMessage "Success"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end fillInFormOrderParts

(* 
This handler will changes the part order status to Delivered
*)
to handle consumeOrderPartsOne
	try
		#Navigates to the Repair Page
		KeyHandlers.clickElement "Repair","rightHalf"
		KeyHandlers.dropDown "Expected Delivery Date","Edit",KeyHandlers.generateSRForLabel("Work Order Parts",[100,-10,750,100]),[150,30]
		#Opens the Work Order Part Item and Changes the  status to Delivered
		KeyHandlers.dropDown "Original Part","Delivered","leftHalf",[150,50]
		#Changes the status to Delivered and it gets saved
		KeyHandlers.clickElement "Save",KeyHandlers.generateSRForLabel("New","topHalf","bottomHalf")
		set the TextStyle to {DPI:144}
		try
			KeyHandlers.validateValues "was saved","headerSection",5
		end try
		#Checks the status of the Work Order
		consumedStatusCheck "Delivered"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end consumeOrderPartsOne

(* 
This handler will change the part order status to Consumed
*)
to handle consumeOrderPartsTwo
	try
		#Navigates to the Repair page
		KeyHandlers.clickElement "Repair","rightHalf"
		#Gets the URL of the existing page
		put "POM/InitiateAndAuthenticate".getURL into WOPRepairURL
		#Navigates to the Consumption page
		KeyHandlers.clickElement "Consumption",KeyHandlers.generateSRForLabel("Work Order Parts",[100,-10,750,100])
		KeyHandlers.validateValues "Update Order Parts","webForm"
		#Filling the details of Parts Used Code and Parts Description in the Consumption page 
		KeyHandlers.dropDown "Parts Used Code","Consumed","rightHalf",[100,55]
		KeyHandlers.clickElement "Part Description","webForm"
		wait 4
		#Repeating the action until the Part Description is displayed
		repeat until not ImageFound(imageName:"workOrder/icons/rightArrow",waitfor:5,SearchRectangle:Sections().SearchAreas.("rightHalf"))
			repeat 5 times
				DoubleClick FoundImageLocation()
			end repeat
			wait 1
		end repeat
		#Filling the Failure Comment 
		KeyHandlers.textEntry "Failure Comment","This comments for testing purpose","topHalf",[150,70]
		#Updating the Order Parts 
		KeyHandlers.clickElement "Update Order Parts","center"
		wait 3
		TypeText controlKey,"l"
		TypeText WOPRepairURL,return
		KeyHandlers.webPageLoad
		#Checks the status of the Work Order
		consumedStatusCheck "Consumed"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end consumeOrderPartsTwo

(* 
This handler is used to check the status of the Work Order Parts
@Params:- workOrderStatus - the status of the Work Order is sent here 
*)
to handle consumedStatusCheck workOrderStatus
	try
		#Setting the Search Rectangle to check the Status of the Work Order Parts 
		set the SearchRectangle to KeyHandlers.generateSRForLabel("Work Order Parts","topHalf","rightPanel")
		KeyHandlers.validateValues workOrderStatus,KeyHandlers.generateSRForLabel("status","topHalf", the SearchRectangle)
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end consumedStatusCheck


(* 
This handler is used to complete the calibration service
*)
to handle completeCalibrationService
	try
		#Navigates to the Calibration Work Order Service
		KeyHandlers.clickElement "Calibration","rightHalf"
		KeyHandlers.validateValues "Ship To Address","leftHalf"
		#Clicking on the in Progress to change its state
		KeyHandlers.clickElement "Complete","rightHalf"
		KeyHandlers.clickElement "Mark as Current Status","rightHalf"
		KeyHandlers.validateValues "Please ensure Work Order Labour","topHalf"
		#Navigates to the Work Order Labour Edit Page
		KeyHandlers.dropDown "Standard Labour Rate","Edit",KeyHandlers.generateSRForLabel("Work Order Labours",[100,-10,750,150]),[150,30]
		KeyHandlers.validateValues "Required Information","rightHalf"
		#Editing the Hours Section from the Work Order Labour Edit Page
		KeyHandlers.textEntry "Hours","4","center",[200,00]
		set the TextStyle to {DPI:144, contrast:"On", contrastColor:"#0075D6", contrastTolerance:"45"}
		#Changes the Hours field and it gets saved
		KeyHandlers.clickElement "Save","bottomHalf"
		set the TextStyle to {DPI:144}
		KeyHandlers.validateValues "was saved","topHalf"
		//Navigating to the top of the webpage
		KeyHandlers.scrollTo "Ship To Address","topHalf","up"
		wait 2
		KeyHandlers.validateValues "Ship To Address","leftHalf"
		#Moving the Work Order Labour to In Progress State
		KeyHandlers.clickElement "In Progress","topHalf"
		KeyHandlers.clickElement "Mark as Current Status","rightHalf"
		KeyHandlers.validateValues "Status changed successfully","topHalf"
		#Moving the Work Order Labour to Complete State
		KeyHandlers.clickElement "Complete","rightHalf"
		KeyHandlers.clickElement "Mark as Current Status","rightHalf"
		KeyHandlers.validateValues "Status changed successfully","topHalf"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end completeCalibrationService


(*
This handler will navigate to WOS Calibration and verifies the calibration Interval
*)
to navigateToWOSCalibrationAndVerifyDateInterval
	try
		#Below line will navigates to Specific Work Order Service
		"POM/workOrderPage".navigateToParticularWorkOrderService "Calibration"
		KeyHandlers.scrollTo "Calibration Due","leftPanel",,2
		#validates the Calibration Interval Field to 12
		KeyHandlers.validateField "Calibration Interval","12",[120,0],"leftPanel"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end navigateToWOSCalibrationAndVerifyDateInterval

(* 
This handler will fill the details in WOS calibration 
 *)
to fillDetailsInWOSCalibration
	try
		#below line will navigates the entire page to Edit mode by double clicking on As Received Condition tab
		KeyHandlers.mouseActionOnPreferredElement "As Received Condition","leftPanel",,DoubleClick
		wait 2
		#Below will fills the mandatory fileds
		KeyHandlers.dropDown "As Received Condition","In Tolerance","leftPanel",[140,0]
		KeyHandlers.dropDown "As Completed Condition","Out Of Tolerance","leftPanel",[140,0]
		KeyHandlers.dropDown "Calibration Date","Today","leftPanel",[140,0]
		KeyHandlers.clickInsideElement "Calibration Date","leftPanel",[140,0]
		KeyHandlers.scrollTo "Internal comments","leftPanel",,2
		#Below line will change the Action Taken to Adj Not Possible
		KeyHandlers.clickElement "Adj Not Possible","leftPanel"
		KeyHandlers.clickElement "workOrder/icons/rightArrow","leftPanel"
		KeyHandlers.clickElement "Save",KeyHandlers.generateSRForLabel( "Cancel","topHalf","leftHalf")
		wait 5
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end fillDetailsInWOSCalibration

(* 
This handler will validate the Calibration Due Date whether it is reflected or not
 *)
to validateCalibrationDueDate
	try
		typetext homeKey
		KeyHandlers.scrollTo "Calibration Interval","leftPanel",,2
		#reads the Calibration Interval Field value
		put KeyHandlers.readField("Calibration Interval",[120,0],"leftPanel") into calibrationInterval
		#calculates the Calibration Due date and validates in screen
		KeyHandlers.validateField "Calibration Due",formattedTime("M/d/yyyy",today plus calibrationInterval months),[120,0],"leftPanel"
		log "Calibration Due Date is reflected that Calibration Date plus Calibration Interval"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end validateCalibrationDueDate

(*
This Handler helps to change the Work Order Service(WOS) of Repair To Complete
*)
to changeRepairWOSToComplete
	try
		#this Handler helps to navigate to Repair WOS
		navigateToParticularWorkOrderService "Repair"
		KeyHandlers.clickElement "Ship To Address","leftHalf"
		KeyHandlers.scrollTo "Quoted Price USD","leftPanel",,2
		wait 3
		#Validating the Quoted And Actual Price after chnaging the Work Order Status
		put KeyHandlers.readField( "Quoted Price USD",[150,0],"leftPanel") into QuotedPriceUSD
		log "Quote Price USD Added Successfully"&&QuotedPriceUSD
		put KeyHandlers.readField( "Actual Price USD",[150,0],"leftPanel") into ActualPriceUSD 
		log "Actual Price USD Added Successfully"&&ActualPriceUSD
		KeyHandlers.scrollTo "Ship To Address","topHalf",UP,7
		#Changing the status of the Work order to Quoted VS Actual
		KeyHandlers.clickElement "Complete","rightPanel"
		KeyHandlers.clickElement "Mark as Current Status","rightPanel"
		try
			set the TextStyle to {DPI:144}
			KeyHandlers.validateValues "You encountered some errors","headerSection"
		end try
		KeyHandlers.scrollTo "Technician Quoted vs Actual Note","leftPanel",,2
		wait 3
		set the TextStyle to {DPI:144}
		#Double click on the Technician Quoted vs Actual Note to enable the editing option
		KeyHandlers.mouseActionOnPreferredElement "Technician Quoted vs Actual Note","leftPanel",,DoubleClick 
		KeyHandlers.textEntry "Technician Quoted vs Actual Note","test","leftPanel",[150,0]
		KeyHandlers.clickElement "Save",KeyHandlers.generateSRForLabel("Cancel","topHalf","leftPanel")
		KeyHandlers.scrollTo "Ship To Address","topHalf",UP,7
		#Changing the status of the Work order to Quoted VS Actual
		KeyHandlers.clickElement "Complete","rightPanel"
		KeyHandlers.clickElement "Mark as Current Status","rightPanel"
		#validating the message to check status changed or not
		"POM/WOHandlers".validateMessage "Status changed successfully"
		set the TextStyle to Default
		#Reading the status of the WOS
		put KeyHandlers.readField("Status" ,[150,0],"leftPanel") into Status
		log "Work Order Service Status:"&&Status
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end changeRepairWOSToComplete

(*
this Handler helps to change the tranship outbound WOS status to clean & close
*)
to changeTranshipWOSToCleanAndClose
	try
		#This Handler helps to navigate to tranship outbound WOS
		navigateToParticularWorkOrderService "Tranship"
		#click on the clean & close button to change the status
		KeyHandlers.clickElement "Clean & Close","leftPanel"
		KeyHandlers.clickElement "Mark as Current Status","rightPanel"
		#validating the message to check status changed or not
		"POM/WOHandlers".validateMessage "Status changed successfully"
		#This Handler helps to edit the data
		editTheProductData
		KeyHandlers.clickElement "Packaging","leftPanel"
		KeyHandlers.clickElement "Mark as Current Status","rightPanel"
		#validating the message to check status changed or not
		"POM/WOHandlers".validateMessage "Status changed successfully"
		#we are copying the url
		put "POM/InitiateAndAuthenticate".getURL into url
		#we are loging with SD System admin credential
		"POM/InitiateAndAuthenticate".launchSalesforce "SD System Admin"
		"POM/InitiateAndAuthenticate".loginToSandbox
		#open the current work order
		openWorkorder
		#remove the gtm hold from On Hold Reason in work order 
		removeGTMHold
		"POM/InitiateAndAuthenticate".launchSalesforce "SD Logistics Admin"
		"POM/InitiateAndAuthenticate".loginToSandbox
		#pasting the copied url 
		typetext controlKey,"l"
		TypeText controlKey,"a"
		TypeText url,returnKey
		KeyHandlers.validateValues "Ship To Address","leftHalf"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end changeTranshipWOSToCleanAndClose
(*
this Handler helps to edit the product data
*)
to editTheProductData
	try
		#double click on the Product is clean to enable edit 
		KeyHandlers.mouseActionOnPreferredElement "Product is clean","leftPanel",,DoubleClick 
		wait 2
		try
			#ifSafety test exist validate its status
			KeyHandlers.validateValues "Safety Test","leftPanel",2
			KeyHandlers.validateField "Safety Test","Passed",[170,0],"leftpanel"
		end try
		KeyHandlers.clickElement "Product is clean","leftpanel"
		KeyHandlers.clickElement "Product is undamaged","leftpanel"
		KeyHandlers.clickElement "Product-No. and Serial-No. matches","leftpanel"
		KeyHandlers.clickElement "Accessories are complete","leftpanel"
		KeyHandlers.clickElement "Save","leftPanel"
		wait 3
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end editTheProductData

to changeTranshipWOSToShipping
	try
		set the TextStyle to {DPI:144}
		KeyHandlers.clickElement "Shipping Administration","leftPanel"
		KeyHandlers.clickElement "Mark as Current Status","rightPanel"
		"POM/WOHandlers".validateMessage "You encountered some errors"
		editTheProductData
		KeyHandlers.clickElement "Mark as Current Status","rightPanel"
		"POM/WOHandlers".validateMessage "Status changed successfully"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end changeTranshipWOSToShipping

to completeTranshipOutBoundService
	try
		changeTranshipWOSToCleanAndClose
		changeTranshipWOSToShipping
		--KeyHandlers.validateValues "Ship To Address","leftHalf"
		KeyHandlers.clickElement "Ready To Ship","rightPanel"
		set the TextStyle to {DPI:144,contrast:on}
		wait 1
		KeyHandlers.clickElement "Mark as Current Status","rightPanel"
		"POM/WOHandlers".validateMessage "Status changed successfully"
		KeyHandlers.clickElement "In Transit","rightPanel"
		KeyHandlers.clickElement "Mark as Current Status","rightPanel"
		"POM/WOHandlers".validateMessage "Status changed successfully"
		KeyHandlers.clickElement "Complete","rightPanel"
		KeyHandlers.clickElement "Mark as Current Status","rightPanel"
		"POM/WOHandlers".validateMessage "Status changed successfully"
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try	
end completeTranshipOutBoundService
