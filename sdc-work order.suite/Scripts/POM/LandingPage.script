(****
COMMONLY USED LINES IN FRAMEWORK :-
the TextStyle : This function is used to configure properties for Optical Character Recognition (OCR) when the default settings struggle to accurately identify text.
ErrorMessageCustomization.captureScreenAndNotifyError theException : This handler captures any exceptions that occur when the script fails, providing a user-friendly error message in the console and taking a snap of the failure.
Params : This refers to the parameters or arguments that are passed to a function or script to customize its behavior or input data. These parameters allow users to specify different values or configurations for the automation tasks, enabling more flexible and reusable scripts
****)

(**
@HandlerName: logOut -- This handler will map the records and it will import)
@Author: Venkatesh Thatavarthi
@Version : 0.1
@Modified Reason (if):
**)

to logOut
	try
		KeyHandlers.clickElement "Log out","headerSection"
		KeyHandlers.webPageLoad
		try
			KeyHandlers.validateValues "Sign in to your account"
		end try
		repeat 3 times
			typetext controlKey,w
		end repeat
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end logOut

(*
This Handlers helps to sleect the required module from the module DropDown 
Params:we are passing the required module name to click
*)
to navigateToSDCModule
	Params module
	try
		try
			KeyHandlers.validateValues module,"headerSection",3
			KeyHandlers.clickElement module,"headerSection"
			KeyHandlers.validateValues "Recently Viewed","headerSection"
		catch
			KeyHandlers.validateValues "Services Delivery","leftHalf"
			KeyHandlers.dropDown "Services Delivery",,,[290,0]
			TypeText homeKey			
			KeyHandlers.mouseActionOnPreferredElement "Service Accounts","SDCModules",,MoveTo
			KeyHandlers.scrollTo module,"SDCModules",,2
			KeyHandlers.clickElement module,"SDCModules"
			set the TextStyle to {DPI:144}
			KeyHandlers.clickElement module,"SDCModules"
			set the TextStyle to {DPI:default}
			try
				KeyHandlers.validateValues "Recently Viewed","topHalf",3
			end try
		end try
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end navigateToSDCModule

(*
This Handler helps to Search the EggPlantRegressionTest Asset
*)
to searchForEggplantRegressionTestAsset
	try
		KeyHandlers.textEntry "Search ...","EggplantRegressionTest","headerSection"
		KeyHandlers.clickElement "EggplantRegressionTestAsset","headerSection"
		KeyHandlers.validateValues "EggplantRegressionTestAsset","leftPanel"
		typetext homeKey
	Catch theException
		ErrorMessageCustomization.captureScreenAndNotifyError theException
	End Try
end searchForEggplantRegressionTestAsset









